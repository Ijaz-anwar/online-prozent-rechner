{
  "name": "percent-master-platform",
  "version": "1.0.0",
  "description": "Comprehensive, modern percentage calculator web application",
  "private": true,
  "scripts": {
    "dev": "npm run dev:client",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "test": "node --test client/src/utils/calculations/percentageCalculations.test.js client/src/utils/calculations/discountCalculation.test.js client/src/utils/calculations/vatCalculation.test.js",
    "start": "npm --prefix server start",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install"
  },
  "keywords": [
    "percentage-calculator",
    "react",
    "vite",
    "express",
    "math-tools"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
